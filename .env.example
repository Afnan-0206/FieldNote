# FieldNote Local Configuration Example
# Copy to .env if you need to override default local settings.

# Backend server port and bind host
PORT=3001
HOST=127.0.0.1

# Ollama local inference endpoint (default local port 11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Configured open-weight model (qwen2.5:7b installed and recommended)
# You can also use qwen2.5:0.5b, llama3.2:3b, or mistral:7b
OLLAMA_MODEL=qwen2.5:7b

# Request timeout in milliseconds (120000ms = 2 minutes for local inference)
REQUEST_TIMEOUT_MS=120000
